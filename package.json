{
  "name": "awushi-devops-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "assets:generate": "node scripts/generate.mjs",
    "assets:branding": "node scripts/render-branding.mjs",
    "assets:compress": "node scripts/compress-branding.mjs",
    "assets:uncompressed": "node scripts/uncompressed-branding.mjs",
    "assets:validate": "node scripts/validate-assets.mjs",
    "test:pipeline": "node --test scripts/test-pipeline.mjs",
    "test:runtime": "node --test scripts/test-runtime.mjs",
    "assets:build": "node scripts/generate.mjs --all && node scripts/validate-assets.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:pipeline && npm run test:runtime && npm run test:unit && npm run assets:validate && npm run build && npm run test:browser",
    "lint": "eslint src tests playwright.config.ts",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "gltf-validator": "^2.0.0-dev.3.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7"
  },
  "overrides": {
    "minimatch@>=7.0.0": "^11.0.1"
  },
  "engines": {
    "node": "24.x"
  }
}
