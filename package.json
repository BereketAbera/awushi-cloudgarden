{
  "name": "awushi-devops-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "assets:generate": "node scripts/generate.mjs",
    "assets:validate": "node scripts/validate-assets.mjs",
    "test:pipeline": "node --test scripts/test-pipeline.mjs",
    "test:runtime": "node --test scripts/test-runtime.mjs",
    "assets:build": "node scripts/generate.mjs --all && node scripts/validate-assets.mjs",
    "verify": "npm run test:pipeline && npm run test:runtime && npm run assets:validate && npm run build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.2.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
